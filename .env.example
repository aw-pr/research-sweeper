# Copy to .env and fill in if you do NOT use 1Password.
#
# Loaded fill-only at startup: a value here is used ONLY when the variable is
# not already set in the environment. It never overrides a real shell export
# or a key injected by the op-fetch / 1Password route, so it is safe to keep
# this file alongside a 1Password setup.
#
# .env.local takes precedence over .env (both are gitignored except this
# .example). Provide whichever providers you intend to use.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Subscription (Max/Pro) sync route — generate with `claude setup-token`:
CLAUDE_CODE_OAUTH_TOKEN=
GEMINI_API_KEY=
# GCP-billed OAuth sync route — supply a valid Bearer token from `gcloud auth print-access-token`:
GOOGLE_ACCESS_TOKEN=

# Where generated research output is written.
# Default: output/ inside the repo (gitignored). Point this at a vault to publish elsewhere.
# A ~/ prefix is expanded and an exported value is also honoured on the secure path.
# RESEARCH_SWEEPER_OUTPUT_DIR=/absolute/path/to/output

# Model for the single synthesis call (the lanes always stay on haiku/sonnet).
# Default: claude-opus-5-5. Override without a code change, e.g. dial it up to
# SYNTHESIS_MODEL=claude-fable-5. Fable 5 is access-gated: it returns
# not_found_error unless your Console admin has accepted 30-day data retention
# (misuse detection only, not training).
# SYNTHESIS_MODEL=claude-opus-5-5

# Claude lane model overrides for the sonnet (deep) and haiku (shallow/standard) tiers.
# LANE_MODEL_SONNET=claude-sonnet-5
# LANE_MODEL_HAIKU=claude-haiku-4-5-20251001

# Optional shared model registry (a models.json with `claude.opus|sonnet|haiku`
# tiers and a `pricing` map). When set, a model bump there reaches this repo
# without a code change. Each model resolves: the env overrides above > this
# registry > the built-in default. Unset, only the built-in defaults apply.
# MODEL_REGISTRY=/absolute/path/to/models.json

# 1Password users: leave this file empty and instead copy
# op-refs.local.sh.example to op-refs.local.sh with your vault refs.
